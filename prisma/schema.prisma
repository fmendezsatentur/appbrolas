generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  accounts        Account[]
  sessions        Session[]
  listings        CardListing[]
  sealedListings  SealedListing[]
  ordersAsBuyer   Order[]         @relation("OrderBuyer")
  ordersAsSeller  Order[]         @relation("OrderSeller")
  auctionsOwned   Auction[]       @relation("AuctionOwner")
  auctionsWon     Auction[]       @relation("AuctionWinner")
  bids            Bid[]
  createdAt       DateTime        @default(now())
  updatedAt     DateTime      @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Auction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("AuctionOwner", fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  imageUrl      String?
  startingPrice Float
  currentPrice  Float
  minIncrement  Float    @default(1)
  endTime       DateTime
  status        String   @default("active")
  winnerId      String?
  winner        User?    @relation("AuctionWinner", fields: [winnerId], references: [id])
  bids          Bid[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endTime])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  createdAt DateTime @default(now())

  @@index([auctionId])
  @@index([userId])
}

model Order {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId    String
  seller      User     @relation("OrderSeller", fields: [sellerId], references: [id])
  listingId   String
  cardName    String
  setName     String?
  imageUrl    String?
  quantity    Int
  price       Float
  condition   String   @default("NM")
  isFoil      Boolean  @default(false)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([buyerId])
  @@index([sellerId])
}

model SealedListing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  price       Float
  tag         String   @default("OTROS")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

model CardListing {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardName        String
  setName         String?
  setCode         String?
  collectorNumber String?
  condition       String   @default("NM")
  isFoil          Boolean  @default(false)
  quantity        Int      @default(1)
  price           Float
  priceRef        Float?
  imageUrl        String?
  scryfallId      String?
  colors          String[] @default([])
  language        String   @default("en")
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cardName])
  @@index([userId])
  @@index([isActive])
}
